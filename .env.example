# ---------------------------------------------------------------------------
# Smart Grid Energy Monitoring & Billing  --  environment template
# Copy to `.env` before running `docker compose up`:
#     PowerShell:  Copy-Item .env.example .env
# ---------------------------------------------------------------------------

COMPOSE_PROJECT_NAME=smartgrid

# --- Image tags (pinned here so the whole stack is reproducible) ------------
KAFKA_IMAGE=apache/kafka:3.9.0
POSTGRES_IMAGE=postgres:16-alpine
S3_IMAGE=chrislusf/seaweedfs:3.80
AWSCLI_IMAGE=amazon/aws-cli:latest

# --- Kafka -----------------------------------------------------------------
# Inside the docker network use kafka:9092; from the host use localhost:29092.
# KRaft formats its metadata log with this value. `kafka-storage format` expects
# a base64-encoded 16-byte UUID (22 chars) rather than free text, so keep this
# shape rather than substituting a descriptive name.
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw
KAFKA_INTERNAL_BOOTSTRAP=kafka:9092
KAFKA_EXTERNAL_BOOTSTRAP=localhost:29092
KAFKA_TOPIC_READINGS=meter.readings
KAFKA_TOPIC_PARTITIONS=3

# --- PostgreSQL (serving layer) --------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smartgrid
POSTGRES_USER=grid
POSTGRES_PASSWORD=gridpass

# --- Object storage: S3-compatible (raw master store + tariff drop) --------
# Provider-neutral names on purpose. The code only ever speaks the S3 API, so
# swapping the provider is a compose-file change -- which is exactly what
# happened once already when MinIO withdrew its public images.
S3_ENDPOINT=http://seaweedfs:8333
S3_EXTERNAL_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=smartgrid
S3_SECRET_KEY=smartgridsecret
S3_REGION=us-east-1
S3_BUCKET_TARIFF=tariff
S3_BUCKET_REPORTS=reports
# There is no raw bucket: the Parquet master store is a mounted volume at
# ./data/raw. See docs/02-tech-stack.md for why Spark cannot write to SeaweedFS.

# --- Simulated clock -------------------------------------------------------
# 1 simulated day == SIM_DAY_REAL_SECONDS real seconds.
SIM_DAY_REAL_SECONDS=300
METER_INTERVAL_SECONDS=2
