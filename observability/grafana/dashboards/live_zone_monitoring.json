{
  "uid": "sg-live",
  "title": "Smart Grid - Live Zone Monitoring",
  "description": "Speed layer: per-zone load and renewable contribution from zone_metrics, plus alerts. Windows are 1 simulated hour (~12.5 real seconds). Charts plot each window at updated_at, the real time the speed layer last wrote it, because window_start is simulated time and would fall outside Grafana's real-time range.",
  "tags": ["smartgrid", "speed-layer"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Renewable contribution by zone (latest complete window)",
      "description": "Red below 15%: the same threshold as the speed layer's low_renewable_contribution alert (config.yaml alerts.low_renewable_pct). 0% overnight is correct.",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT * FROM (\n  SELECT DISTINCT ON (grid_zone) window_start AS \"time\", grid_zone, renewable_pct\n    FROM zone_metrics\n   WHERE window_start < (SELECT max(window_start) FROM zone_metrics)\n   ORDER BY grid_zone, window_start DESC\n) latest ORDER BY \"time\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.grid_zone}",
          "unit": "percent",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 15 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Grid load by zone (kWh per simulated hour, latest complete window)",
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT * FROM (\n  SELECT DISTINCT ON (grid_zone) window_start AS \"time\", grid_zone, total_consumption_kwh\n    FROM zone_metrics\n   WHERE window_start < (SELECT max(window_start) FROM zone_metrics)\n   ORDER BY grid_zone, window_start DESC\n) latest ORDER BY \"time\""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.grid_zone}",
          "unit": "kwatth",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Simulated clock (newest window)",
      "description": "Start of the window the speed layer is filling now, in simulated Asia/Colombo time.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(max(window_start) AT TIME ZONE 'Asia/Colombo', 'YYYY-MM-DD HH24:MI') AS \"Simulated window\"\n  FROM zone_metrics"
        }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "text" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "/.*/", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Seconds since last speed-layer write",
      "description": "now() - max(updated_at): the only real-time clock in zone_metrics. Stays under ~15 s while the producer and speed layer run; climbs when either stops.",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT EXTRACT(EPOCH FROM (now() - max(updated_at)))::float AS \"Seconds since last write\"\n  FROM zone_metrics"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 30 },
              { "color": "red", "value": 60 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Active meters (latest complete window)",
      "description": "Sum over zones. The speed layer counts meters with HyperLogLog, so this is an estimate; the batch layer's count is exact.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT sum(active_meters) AS \"Active meters\" FROM (\n  SELECT DISTINCT ON (grid_zone) active_meters\n    FROM zone_metrics\n   WHERE window_start < (SELECT max(window_start) FROM zone_metrics)\n   ORDER BY grid_zone, window_start DESC\n) latest"
        }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Alerts in selected time range",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 5 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT count(*) AS \"Alerts\" FROM alerts WHERE $__timeFilter(ts)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Renewable contribution by zone (%)",
      "description": "One point per simulated-hour window, placed at the real time it was last written. 30 real minutes = 6 simulated days. The red line is the 15% alert threshold.",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT updated_at AS \"time\", grid_zone, renewable_pct\n  FROM zone_metrics\n WHERE $__timeFilter(updated_at)\n ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.grid_zone}",
          "unit": "percent",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 15 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Grid load by zone (kWh per simulated hour)",
      "description": "Consumption per window. The daily cycle repeats every 5 real minutes: overnight base load, then the evening peak.",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT updated_at AS \"time\", grid_zone, total_consumption_kwh\n  FROM zone_metrics\n WHERE $__timeFilter(updated_at)\n ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "displayName": "${__field.labels.grid_zone}",
          "unit": "kwatth",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Recent alerts",
      "description": "Newest first. Time is real time; a low-renewable message also names the simulated window that breached.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT ts AS \"Time\", level AS \"Level\", grid_zone AS \"Zone\", rule AS \"Rule\", message AS \"Message\"\n  FROM alerts\n ORDER BY ts DESC\n LIMIT 50"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ]
}
