{
  "uid": "sg-ops",
  "title": "Smart Grid - Pipeline Health",
  "description": "Operations view: Prometheus alert state, producer throughput, end-to-end lag, error counts, and the pipeline_runs log with each run's correlation id.",
  "tags": ["smartgrid", "observability"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Firing alerts",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "count(ALERTS{alertstate=\"firing\"}) or vector(0)",
          "instant": true,
          "range": false,
          "legendFormat": "firing"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scrape targets",
      "description": "Prometheus's own view: can it reach each component's /metrics?",
      "gridPos": { "h": 4, "w": 10, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "up",
          "instant": true,
          "range": false,
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last billing run duration",
      "description": "Newest successful billing_batch run in pipeline_runs.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "smartgrid_batch_last_duration_seconds",
          "instant": true,
          "range": false,
          "legendFormat": "duration"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Alerts (pending or firing)",
      "description": "From Prometheus's ALERTS series. Rules: observability/prometheus/alert_rules.yml. Empty means healthy.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "ALERTS",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true, "Value": true, "__name__": true } } }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Producer throughput (events/s)",
      "description": "40 meters every 2 real seconds = 20 events/s. Drops to nothing when the producer stops.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "rate(smartgrid_producer_events_total[1m])",
          "legendFormat": "events/s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "rate(smartgrid_producer_late_events_total[1m])",
          "legendFormat": "late events/s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "End-to-end lag (seconds since a zone window reached Postgres)",
      "description": "The NoMeterData health check fires when this stays above the red line (30 s) for 10 s.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "smartgrid_serving_lag_seconds",
          "legendFormat": "lag"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "thresholdsStyle": { "mode": "line" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "transparent", "value": null },
              { "color": "red", "value": 30 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Errors (last 5 minutes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "increase(smartgrid_producer_send_errors_total[5m])",
          "legendFormat": "producer send errors"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "sum(increase(smartgrid_api_errors_total[5m])) or vector(0)",
          "legendFormat": "API errors"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "sg-prometheus" },
          "expr": "delta(smartgrid_pipeline_runs{status=\"FAILED\"}[5m])",
          "legendFormat": "failed runs: {{component}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "decimals": 0,
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Recent pipeline runs (correlation ids)",
      "description": "Every Spark job registers here with the run_id it stamps on its JSON log lines and on the rows it writes. docker compose logs <service> | findstr <run_id> finds that run's logs.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
      "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "grafana-postgresql-datasource", "uid": "sg-postgres" },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT run_id, component, status, sim_day, started_at, finished_at, rows_written\n  FROM pipeline_runs\n ORDER BY started_at DESC\n LIMIT 15"
        }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "showHeader": true, "cellHeight": "sm" }
    }
  ]
}
